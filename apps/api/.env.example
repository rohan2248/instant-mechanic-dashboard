# PostgreSQL connection string (Neon). Requires PostgreSQL >= 15.
# Create the Neon project in the SAME AWS region as your EC2 instance.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Port the API listens on.
PORT=4000

# Origin allowed to call this API. Set to your Vercel URL in production.
CORS_ORIGIN="http://localhost:3000"
