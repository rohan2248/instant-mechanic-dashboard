generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum BookingStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MechanicStatus {
  AVAILABLE
  ON_JOB
  OFF_DUTY
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum UserRole {
  ADMIN
  OPS
}

// ---------- catalogue ----------

model ServiceCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  services  Service[]
  createdAt DateTime  @default(now())
}

model Service {
  id             Int             @id @default(autoincrement())
  name           String
  categoryId     Int
  category       ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  basePricePaise Int
  durationMins   Int
  isActive       Boolean         @default(true)
  bookings       Booking[]
  createdAt      DateTime        @default(now())

  @@unique([categoryId, name])
  @@index([categoryId])
}

// ---------- people & assets ----------

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  phone     String    @unique
  city      String
  vehicles  Vehicle[]
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
}

model Vehicle {
  id           Int       @id @default(autoincrement())
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make         String
  model        String
  year         Int
  registration String    @unique
  fuelType     FuelType
  bookings     Booking[]
  createdAt    DateTime  @default(now())

  @@index([customerId])
}

model Mechanic {
  id        Int            @id @default(autoincrement())
  name      String
  email     String         @unique
  phone     String         @unique
  status    MechanicStatus @default(AVAILABLE)
  hiredAt   DateTime       @default(now())
  bookings  Booking[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
}

// ---------- the core table ----------

model Booking {
  id          Int            @id @default(autoincrement())
  reference   String         @unique
  customerId  Int
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId   Int
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceId   Int
  service     Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  mechanicId  Int?
  mechanic    Mechanic?      @relation(fields: [mechanicId], references: [id], onDelete: SetNull)
  status      BookingStatus  @default(PENDING)
  amountPaise Int
  scheduledAt DateTime
  scheduledOn DateTime       @db.Date
  completedAt DateTime?
  events      BookingEvent[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, scheduledAt])
  @@index([scheduledAt])
  @@index([scheduledOn])
  @@index([mechanicId, status])
  @@index([customerId])
  @@index([serviceId])
}

model BookingEvent {
  id         Int            @id @default(autoincrement())
  bookingId  Int
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  note       String?
  createdAt  DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@index([createdAt])
}

// ---------- auth (wire later) ----------

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(OPS)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
